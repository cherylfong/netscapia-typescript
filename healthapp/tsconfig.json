{
  "compilerOptions": {
    "target": "esnext",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "noEmit": true,
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  }
}
